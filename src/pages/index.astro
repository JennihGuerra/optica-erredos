---
/**
 * INICIO — presenta la óptica y dirige a productos, servicios y contacto.
 * Los textos marcados como provisionales deben validarse con el negocio.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import logoHorizontal from '../assets/logo-horizontal.png';
import heroProductos from '../assets/hero-productos.jpg';
import heroAtencionVisual from '../assets/hero-atencion-visual.jpg';
import heroConvenios from '../assets/hero-convenios.jpg';
import categoriaOpticos from '../assets/categoria-opticos.jpg';
import categoriaAccesorios from '../assets/categoria-accesorios.jpg';
import promocion from '../assets/promocion.jpg';
import categoriaSol from '../assets/categoria-sol.jpg';
import fotoAtencionVisual from '../assets/servicio-atencion-visual.jpg';
import fotoReparacion from '../assets/servicio-reparacion.jpg';
import ServicePrice from '../components/ui/ServicePrice.astro';
import Icon from '../components/ui/Icon.astro';
import MediaPlaceholder from '../components/ui/MediaPlaceholder.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import LocationBlock from '../components/ui/LocationBlock.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { featuredProducts, productTypeRoutes } from '../data/products';
import { services } from '../data/services';
import { whatsappUrl, whatsappMessages, promotionImageLink } from '../lib/whatsapp';
import type { IconName } from '../components/ui/icons';

// Fotos PROVISIONALES de banco para las tarjetas de servicios (las mismas de /servicios).
const servicePhotos: Record<string, { src: ImageMetadata; alt: string; position: string }> = {
  'atencion-visual': { src: fotoAtencionVisual, alt: 'Persona probándose lentes de prueba durante una evaluación visual', position: 'center 30%' },
  'reparacion-y-ajuste': { src: fotoReparacion, alt: 'Manos ajustando unos anteojos con un destornillador sobre un mesón con herramientas', position: 'center 55%' },
};

// Banner principal: carrusel de tres entradas.
const slides: {
  kicker?: string;
  title: string;
  titleLogo?: boolean;
  titleLines?: string[];
  text: string;
  /** Letra pequeña bajo los botones. */
  fine?: string;
  actions: { label: string; href: string }[];
  icon: IconName;
  imageLabel: string;
  /** Fotografía de fondo a todo el ancho. Sin ella, la diapositiva muestra la imagen lateral provisional. */
  background?: ImageMetadata;
  /** Encuadre de la fotografía de fondo (CSS object-position). */
  backgroundPosition?: string;
}[] = [
  {
    title: 'Encuentra tus próximos anteojos en óptica',
    /** Dos líneas fijas; el logo va en una tercera línea y mide lo mismo que la más ancha. */
    titleLines: ['Encuentra tus próximos', 'anteojos en óptica'],
    /** Cierra el título con el logo horizontal (su nombre accesible es «Óptica Erredos»). */
    titleLogo: true,
    text: 'Descubre alternativas para tu día a día y conoce nuestros servicios de atención óptica.',
    actions: [
      { label: 'Ver productos', href: '/productos' },
      { label: 'Conoce nuestros servicios', href: '/servicios' },
    ],
    icon: 'eyeglasses',
    imageLabel: 'persona usando anteojos ópticos',
    background: heroProductos,
  },
  {
    kicker: 'Atención visual',
    title: 'Tu salud visual es importante.',
    text: 'Conoce nuestra atención visual y recibe orientación de nuestra tecnóloga.',
    actions: [{ label: 'Agenda tu hora', href: '/servicios#agendar-hora' }],
    fine: services.find((s) => s.slug === 'atencion-visual')?.pricing?.fine,
    icon: 'visibility',
    imageLabel: 'atención visual en la óptica',
    // PROVISIONAL: imagen genérica. Muestra equipos y un procedimiento que el negocio no ha confirmado.
    background: heroAtencionVisual,
    // Encuadre alto: las personas (parte superior de la foto) quedan dentro del banner.
    backgroundPosition: '62% 18%',
  },
  {
    kicker: 'Convenios y operativos',
    title: 'Soluciones ópticas para tu organización.',
    text: 'Acercamos alternativas ópticas a empresas, sindicatos e instituciones.',
    actions: [{ label: 'Conocer convenios', href: '/empresas' }],
    icon: 'handshake',
    imageLabel: 'atención óptica a un grupo de personas',
    // PROVISIONAL: imagen genérica. Se ve publicidad de otra marca; reemplazar antes de publicar.
    background: heroConvenios,
  },
];

// PROVISIONAL: beneficios de ejemplo. No agregar garantías ni descuentos sin confirmación.
const benefits: { title: string; description: string; icon: IconName }[] = [
  {
    title: 'Atención y asesoría personalizada',
    description: 'Te escuchamos y orientamos para que elijas con confianza.',
    icon: 'handshake',
  },
  {
    title: 'Alternativas para distintas necesidades',
    description: 'Anteojos ópticos y de sol en distintos estilos.',
    icon: 'widgets',
  },
  {
    title: 'Orientación para elegir tus anteojos',
    description: 'Te ayudamos a encontrar la opción que va contigo.',
    icon: 'explore',
  },
];

const categories = [
  {
    href: productTypeRoutes.opticos,
    title: 'Anteojos ópticos',
    icon: 'eyeglasses' as IconName,
    tone: 'primary' as const,
    // PROVISIONAL: imagen de banco (persona probándose anteojos en una óptica).
    image: categoriaOpticos as ImageMetadata | undefined,
    imagePosition: 'center 35%',
  },
  {
    href: productTypeRoutes.sol,
    title: 'Anteojos de sol',
    icon: 'sunny' as IconName,
    tone: 'accent' as const,
    // PROVISIONAL: imagen de banco (persona con anteojos de sol).
    image: categoriaSol as ImageMetadata | undefined,
    imagePosition: 'center 12%',
  },
  {
    // PROVISIONAL: imagen de banco (fundas de anteojos).
    href: productTypeRoutes.accesorios,
    title: 'Accesorios ópticos',
    icon: 'cleaning_services' as IconName,
    tone: 'neutral' as const,
    image: categoriaAccesorios as ImageMetadata | undefined,
    imagePosition: 'center 40%' as string | undefined,
  },
];
---

<BaseLayout
  title="Óptica en Puerto Montt"
  description="Óptica Erredos en Puerto Montt: anteojos ópticos, anteojos de sol y atención óptica. Consulta por WhatsApp o visítanos en Calle Talca 118."
>
  <!-- 2. Hero: banner tipo carrusel -->
  <section class="hero" aria-roledescription="carrusel" aria-label="Destacados de Óptica Erredos" data-carousel>
    <div class="hero__track" data-track>
      {
        slides.map((slide, index) => {
          const Heading = index === 0 ? 'h1' : 'h2';
          return (
            <div
              class:list={['hero__slide', { 'hero__slide--photo': slide.background }]}
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`${index + 1} de ${slides.length}`}
              data-slide
            >
              {slide.background && (
                <Image
                  class="hero__bg"
                  src={slide.background}
                  alt=""
                  widths={[...new Set([640, 1024, 1600, slide.background.width].filter((w) => w <= slide.background!.width))]}
                  sizes="100vw"
                  style={slide.backgroundPosition ? `object-position: ${slide.backgroundPosition}` : undefined}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
              )}
              <div class="container hero__inner">
                <div class="hero__content">
                  {slide.kicker && <p class="hero__kicker">{slide.kicker}</p>}
                  <Heading class="hero__title">
                    {slide.titleLines ? (
                      slide.titleLines.map((line) => <span class="hero__line">{line}</span>)
                    ) : (
                      slide.title
                    )}
                    {slide.titleLogo && (
                      <span class="hero__title-end">
                        <Image class="hero__logo" src={logoHorizontal} alt="Erredos" widths={[320, 640, 1000]} sizes="14em" loading="eager" />
                      </span>
                    )}
                  </Heading>
                  <p class="hero__text">{slide.text}</p>
                  {slide.fine && <p class="hero__fine">{slide.fine}</p>}
                  <div class="hero__actions">
                    {slide.actions.map((action, i) => (
                      <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--outline']} href={action.href}>
                        {action.label}
                      </a>
                    ))}
                  </div>
                </div>
                {!slide.background && (
                  <MediaPlaceholder
                    class="hero__media"
                    icon={slide.icon}
                    ratio="4 / 3"
                    tone="accent"
                    label={slide.imageLabel}
                  />
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Controles: solo aparecen cuando el carrusel está activo (con JavaScript). -->
    <div class="container hero__controls" data-controls hidden>
      <div class="hero__pill on-primary">
      <button type="button" class="hero__control" data-prev aria-label="Diapositiva anterior">
        <Icon name="chevron_left" />
      </button>
      <div class="hero__dots" role="group" aria-label="Elegir diapositiva">
        {
          slides.map((slide, index) => (
            <button
              type="button"
              class="hero__dot"
              data-dot
              aria-label={`Diapositiva ${index + 1} de ${slides.length}: ${slide.kicker ?? 'Productos'}`}
              aria-current={index === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <button type="button" class="hero__control" data-next aria-label="Diapositiva siguiente">
        <Icon name="chevron_right" />
      </button>
      <button type="button" class="hero__control hero__play" data-play aria-label="Pausar el cambio automático">
        <Icon name="pause" class="hero__icon-pause" />
        <Icon name="play_arrow" class="hero__icon-play" />
      </button>
      </div>
    </div>
  </section>

  <!-- 2b. Beneficio: entrega el mismo día -->
  <section class="same-day on-primary" aria-labelledby="mismo-dia-title">
    <div class="container same-day__inner">
      <span class="same-day__icon" aria-hidden="true"><Icon name="schedule" /></span>
      <div class="same-day__main">
        <h2 id="mismo-dia-title" class="same-day__title">¡Tus anteojos listos el mismo día!</h2>
        <p class="same-day__text">Trae tu receta durante la mañana y consulta por la entrega el mismo día.</p>
      </div>
      <p class="same-day__note">Aplica a tratamientos estándar. Lentes bifocales y con adelgazado pueden requerir más tiempo.</p>
    </div>
  </section>

  <!-- 4. Beneficios -->
  <section class="container section" aria-labelledby="beneficios-title">
    <SectionHeader id="beneficios-title" title="Por qué elegir Erredos" />
    <ul role="list" class="benefits">
      {
        benefits.map((benefit) => (
          <li>
            <Icon name={benefit.icon} />
            <div>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Categorías -->
  <section class="container section" aria-labelledby="categorias-title">
    <SectionHeader
      id="categorias-title"
      title="Explora nuestros productos"
      description="Desde anteojos ópticos y de sol hasta accesorios: elige la categoría que necesitas y encuentra el estilo que va contigo."
    />
    <ul role="list" class="categories">
      {
        categories.map((category) => (
          <li>
            <a
              href={category.href}
            >
              {category.image ? (
                <Image
                  class="categories__photo"
                  src={category.image}
                  alt=""
                  widths={[480, 640]}
                  sizes="(min-width: 48em) 50vw, 100vw"
                  style={category.imagePosition ? `object-position: ${category.imagePosition}` : undefined}
                  loading="lazy"
                />
              ) : (
                <MediaPlaceholder
                  icon={category.icon}
                  ratio="16 / 9"
                  tone={category.tone}
                  label={category.title.toLowerCase()}
                />
              )}
              <span class="categories__title">
                <span>
                  {category.title}
                </span>
                <Icon name="arrow_forward" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 6. Productos destacados -->
  <section class="section" aria-labelledby="destacados-title">
    <div class="container">
      <SectionHeader
        id="destacados-title"
        title="Productos destacados"
        description="Los favoritos de nuestros clientes: anteojos ópticos y de sol que combinan estilo y comodidad para tu día a día."
        link={{ href: '/productos', label: 'Ver todos' }}
      />
    </div>
    <ul role="list" class="featured">
      {
        featuredProducts.map((product) => (
          <li>
            <ProductCard product={product} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 7. Promociones -->
  <section class="container section" aria-labelledby="promos-title">
    <h2 id="promos-title" class="visually-hidden">Promociones y ofertas</h2>
    <div class="promo">
      <Image class="promo__photo" src={promocion} alt="Afiche promocional" widths={[640, 1024]} sizes="(min-width: 75em) 1200px, 100vw" loading="lazy" />
      <a
        class="btn promo__cta"
        href={whatsappUrl(whatsappMessages.promotion(promotionImageLink()))}
        target="_blank"
        rel="noopener"
      >
        Solicitar promoción<span class="visually-hidden"> por WhatsApp (se abre en una pestaña nueva)</span>
        <Icon name="arrow_forward" />
      </a>
    </div>
  </section>

  <!-- 8. Servicios -->
  <section class="container section" aria-labelledby="servicios-title">
    <SectionHeader
      id="servicios-title"
      title="Nuestros servicios"
      description="Atención visual y reparación de anteojos en Puerto Montt."
    />
    <ul role="list" class="services">
      {
        services.map((service) => {
          const photo = servicePhotos[service.slug];
          return (
            <li>
              <div class="services__media">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[360, 560, 800]}
                  sizes="(min-width: 48em) 50vw, 100vw"
                  style={`object-position: ${photo.position}`}
                />
              </div>
              <div class="services__body">
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                {service.pricing && <ServicePrice {...service.pricing} />}
                {service.slug === 'atencion-visual' ? (
                  <a class="btn btn--primary services__action" href="/servicios#agendar-hora">
                    <Icon name="event_available" />
                    <span>Agenda tu hora</span>
                  </a>
                ) : (
                  <a
                    class="btn btn--outline services__action"
                    href={whatsappUrl(service.whatsappMessage)}
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="chat" />
                    <span>
                      {service.cta}
                      <span class="visually-hidden"> por WhatsApp (se abre en una pestaña nueva)</span>
                    </span>
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- 9. Convenios y operativos -->
  <section class="b2b on-primary" aria-labelledby="empresas-title">
    <div class="container b2b__inner">
      <span class="b2b__icon"><Icon name="handshake" /></span>
      <div class="b2b__text">
        <p class="b2b__kicker">Convenios y operativos</p>
        <h2 id="empresas-title">Acercamos soluciones ópticas a empresas y organizaciones</h2>
        <p class="b2b__lead">
          Si tu empresa, sindicato o institución busca facilitar el acceso a productos y servicios visuales para sus integrantes, podemos conversar sobre convenios y coordinar operativos ópticos. Cuéntanos qué necesitas y nos ponemos en contacto.
        </p>
      </div>
      <a class="btn btn--accent b2b__cta" href="/empresas">Conoce nuestros convenios</a>
    </div>
  </section>

  <!-- 10. Ubicación y contacto -->
  <section class="container section" aria-labelledby="ubicacion-title">
    <LocationBlock headingId="ubicacion-title" />
  </section>
</BaseLayout>

<script>
  const AUTOPLAY_MS = 7000;

  function initCarousel() {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: number | undefined;
    // Con "reducir movimiento" activado, el banner parte en pausa.
    let paused = reduceMotion.matches;

    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false;

    function render() {
      slides.forEach((slide, index) => {
        // Las diapositivas ocultas no reciben foco ni se leen.
        slide.inert = index !== current;
      });
      dots.forEach((dot, index) => {
        if (index === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      track.scrollTo({
        left: slides[current].offsetLeft - track.offsetLeft,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
      render();
    }

    function stop() {
      window.clearInterval(timer);
      timer = undefined;
    }

    function start() {
      stop();
      if (!paused) timer = window.setInterval(() => goTo(current + 1), AUTOPLAY_MS);
    }

    function setPaused(value: boolean) {
      paused = value;
      play.setAttribute('aria-pressed', String(paused));
      play.setAttribute(
        'aria-label',
        paused ? 'Reanudar el cambio automático' : 'Pausar el cambio automático',
      );
      // En pausa, los cambios de diapositiva se anuncian a lectores de pantalla.
      track.setAttribute('aria-live', paused ? 'polite' : 'off');
      start();
    }

    // Al deslizar con el dedo, el estado sigue a la diapositiva visible.
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== current && slides[index]) {
          current = index;
          render();
        }
      });
    });

    // Cualquier uso manual detiene el cambio automático: la persona toma el control.
    root.querySelector('[data-prev]')!.addEventListener('click', () => (setPaused(true), goTo(current - 1)));
    root.querySelector('[data-next]')!.addEventListener('click', () => (setPaused(true), goTo(current + 1)));
    dots.forEach((dot, index) => dot.addEventListener('click', () => (setPaused(true), goTo(index))));
    track.addEventListener('pointerdown', () => setPaused(true));
    play.addEventListener('click', () => setPaused(!paused));

    // Se detiene mientras el puntero o el foco están sobre el banner, y si la pestaña no está visible.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    document.addEventListener('astro:before-swap', stop, { once: true });

    render();
    setPaused(paused);
  }

  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>

<style>
  .section {
    padding-top: var(--section-gap);
  }


  /* --- Hero: carrusel ---------------------------------------------------
     La fotografía se muestra a todo color. Solo la zona del texto lleva un degradado
     blanco que se desvanece hacia la imagen; el texto es negro carbón.
     - Móvil: foto arriba; su borde inferior se funde a blanco y el texto sigue debajo.
     - Desde 768 px: la foto ocupa todo el banner; el blanco parte a la izquierda (88 %,
       así siempre se intuye la imagen) y se desvanece hacia la derecha.
     Las diapositivas van en una fila con ajuste de desplazamiento (se puede deslizar
     con el dedo y, sin JavaScript, sigue siendo contenido normal desplazable). */

  .hero {
    position: relative;
    background: var(--color-bg);
  }

  .hero__track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .hero__track::-webkit-scrollbar {
    display: none;
  }

  .hero__slide {
    /* Alto de la foto en móvil. Fijo en px: no se achica cuando se amplía el texto. */
    --hero-img-h: clamp(210px, 66vw, 320px);

    position: relative;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .hero__slide :global(.hero__bg) {
    display: block;
    width: 100%;
    height: var(--hero-img-h);
    object-fit: cover;
    object-position: center 65%;
  }

  /* Móvil: el borde inferior de la foto se funde a blanco. */
  .hero__slide::after {
    content: '';
    position: absolute;
    top: calc(var(--hero-img-h) - 6rem);
    right: 0;
    left: 0;
    height: 6rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), rgb(255 255 255 / 0.9) 70%, #fff);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-4);
    margin-top: -1.75rem;
    padding-bottom: var(--space-4);
  }

  .hero__kicker {
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  /* El título se ve igual en las tres diapositivas, sea h1 o h2. */
  .hero__title {
    /* Con tope según el ancho: en pantallas angostas con texto ampliado no se parten las palabras. */
    font-size: min(var(--text-3xl), 9.5vw);
    font-weight: var(--font-bold);
  }

  /* Título en dos líneas fijas y logo en una tercera, del mismo ancho que la línea más larga. */
  .hero__title:has(.hero__title-end) {
    width: fit-content;
    max-width: 100%;
  }
  .hero__line {
    display: block;
  }
  .hero__title-end {
    display: block;
    width: 100%;
    margin-top: 0.12em;
  }
  .hero__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__text {
    max-width: 45ch;
    margin-top: var(--space-3);
    font-size: var(--text-lg);
  }

  /* Botones siempre uno al lado del otro. En pantallas angostas se reparten el ancho
     y, si hace falta, el texto del botón baja a una segunda línea. */
  .hero__actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .hero__actions .btn {
    flex: 0 1 auto;
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
  }

  /* Letra pequeña (valor de la atención): legible, discreta y sin competir con los botones. */
  .hero__fine {
    max-width: 38ch;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .hero__fine + .hero__actions {
    margin-top: var(--space-3);
  }

  /* --- Controles: una píldora azul sólida, legible sobre cualquier fotografía --- */

  .hero__controls {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-4);
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
