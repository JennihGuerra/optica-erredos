---
/**
 * SERVICIOS — dos servicios (atención visual y reparación de anteojos) y
 * contacto por WhatsApp como canal principal. Sin reservas ni formulario.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import MediaPlaceholder from '../components/ui/MediaPlaceholder.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import { Image } from 'astro:assets';
import heroServicios from '../assets/hero-atencion-visual.jpg';
import fotoAtencionVisual from '../assets/servicio-atencion-visual.jpg';
import fotoReparacion from '../assets/servicio-reparacion.jpg';
import LocationBlock from '../components/ui/LocationBlock.astro';
import Faq from '../components/ui/Faq.astro';
import AppointmentForm from '../components/forms/AppointmentForm.astro';
import { site } from '../config/site';
import { services, servicesFaq } from '../data/services';
import { whatsappUrl, whatsappMessages } from '../lib/whatsapp';

/* Fotos por servicio (PROVISIONALES, de banco). Sin foto = marcador. */
const servicePhotos: Record<string, { src: ImageMetadata; alt: string; position: string }> = {
  'atencion-visual': { src: fotoAtencionVisual, alt: 'Persona probándose lentes de prueba durante una evaluación visual', position: 'center 30%' },
  'reparacion-y-ajuste': { src: fotoReparacion, alt: 'Manos ajustando unos anteojos con un destornillador sobre un mesón con herramientas', position: 'center 55%' },
};

const steps = [
  { title: 'Elige el servicio', text: 'Identifica si necesitas atención visual o reparar tus anteojos.' },
  { title: 'Contáctanos', text: 'Envíanos tu consulta por WhatsApp.' },
  { title: 'Coordinamos contigo', text: 'Te orientaremos sobre disponibilidad y próximos pasos.' },
];
const newTab = ' (se abre en una pestaña nueva)';
---

<BaseLayout
  title="Servicios: atención visual y reparación de anteojos"
  description="Atención visual con tecnóloga y reparación y ajuste de anteojos en Óptica Erredos, Calle Talca 118, Puerto Montt. Consulta por WhatsApp."
>
  <!-- A. Hero (banner con foto, mismo estilo que el carrusel de Inicio) -->
  <PageBanner
    title="Estamos aquí para ayudarte a cuidar tu visión"
    text="Conoce nuestros servicios de atención visual y reparación de anteojos. En Óptica Erredos queremos ayudarte a encontrar la orientación y solución que necesitas."
    image={heroServicios}
    imagePosition="62% 18%"
  >
    <div class="banner-actions">
      <a class="btn btn--primary" href="#agendar-hora">Agenda tu hora</a>
      <a class="btn btn--outline" href={whatsappUrl(whatsappMessages.repair)} target="_blank" rel="noopener">
        Repara tus anteojos<span class="visually-hidden"> por WhatsApp{newTab}</span>
      </a>
    </div>
  </PageBanner>

  <!-- B. Nuestros servicios -->
  <section class="container section" id="servicios" aria-labelledby="servicios-title">
    <h2 id="servicios-title">Nuestros servicios</h2>
    <ul role="list" class="services">
      {
        services.map((service, index) => (
          <li>
            <article class="service" id={service.slug}>
              {servicePhotos[service.slug] ? (
                <Image
                  class="service__photo"
                  src={servicePhotos[service.slug].src}
                  alt={servicePhotos[service.slug].alt}
                  widths={[480, 640, 960]}
                  sizes="(min-width: 48em) 50vw, 100vw"
                  style={`object-position: ${servicePhotos[service.slug].position}`}
                />
              ) : (
                <MediaPlaceholder
                  icon={service.icon}
                  ratio="16 / 9"
                  tone={index === 0 ? 'primary' : 'accent'}
                  label={service.imageLabel}
                />
              )}
              <div class="service__body">
                <span class:list={['service__icon', { 'service__icon--alt': index === 1 }]}>
                  <Icon name={service.icon} />
                </span>
                <h3>{service.name}</h3>
                <p>{service.description}</p>

                {service.examples && (
                  <div class="service__examples">
                    <p class="service__examples-title">{service.examples.title}</p>
                    <ul>
                      {service.examples.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <p class="service__note">{service.examples.note}</p>
                  </div>
                )}

                {service.notice && (
                  <p class="service__notice">
                    <Icon name="info" />
                    <span>{service.notice}</span>
                  </p>
                )}

                <div class="service__actions">
                  {service.primaryAction && (
                    <a class="btn btn--primary" href={service.primaryAction.href}>
                      <Icon name="event_available" />
                      <span>{service.primaryAction.label}</span>
                    </a>
                  )}
                  <a
                    class:list={['btn', service.primaryAction ? 'btn--outline' : 'btn--primary']}
                    href={whatsappUrl(service.whatsappMessage)}
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="chat" />
                    <span>
                      {service.cta}
                      <span class="visually-hidden"> por WhatsApp{newTab}</span>
                    </span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Agendar hora de atención visual -->
  <section class="booking-band" id="agendar-hora" aria-labelledby="booking-title">
   <div class="container booking">
    <div class="booking__intro">
      <p class="eyebrow">Atención visual</p>
      <h2 id="booking-title">Agenda tu hora de atención visual</h2>
      <p class="booking__lead">Elige el día y la hora que prefieras, y luego déjanos tus datos.</p>
      <ul role="list" class="booking__notes">
        <li class="booking__note--strong">
          <Icon name="info" />
          <span>
            <strong>{site.appointments.ageNotice}</strong>
          </span>
        </li>
        <li>
          <Icon name="schedule" />
          <span>
            <strong>Cada atención dura {site.appointments.slotMinutes} minutos</strong>
            <span class="booking__slot">
              Lunes a viernes: {site.appointments.weekdays.map((b) => `${b[0]} a ${b[1]}`).join(' y ')} hrs
            </span>
            <span class="booking__slot">
              Sábados: {site.appointments.saturday.map((b) => `${b[0]} a ${b[1]}`).join(' y ')} hrs
            </span>
          </span>
        </li>
        <li>
          <Icon name="event_available" />
          <span>
            <strong>Agenda en dos pasos.</strong> Elige el día y la hora, y luego déjanos tus datos de
            contacto.
          </span>
        </li>
      </ul>
    </div>
    <div class="booking__form">
      <AppointmentForm />
    </div>
   </div>
  </section>

  <!-- C + D. Cómo solicitar atención y contacto por servicio -->
  <section class="how section" id="solicitar-atencion" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title">¿Cómo solicitar atención?</h2>
      <ol role="list" class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="steps__number" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>
                  <span class="visually-hidden">Paso {index + 1}: </span>
                  {step.title}
                </h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="how__contact">
        <p id="how-contact-label">¿Qué necesitas consultar?</p>
        <div class="how__buttons" role="group" aria-labelledby="how-contact-label">
          <a class="btn btn--accent" href={whatsappUrl(whatsappMessages.visualCare)} target="_blank" rel="noopener">
            <Icon name="visibility" />
            <span>Consultar atención visual<span class="visually-hidden"> por WhatsApp{newTab}</span></span>
          </a>
          <a class="btn btn--accent" href={whatsappUrl(whatsappMessages.repair)} target="_blank" rel="noopener">
            <Icon name="build" />
            <span>Consultar reparación<span class="visually-hidden"> por WhatsApp{newTab}</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- E. Preguntas frecuentes -->
  <section class="container section" aria-labelledby="faq-title">
    <h2 id="faq-title">Preguntas frecuentes</h2>
    <div class="faq-wrap">
      <Faq groups={servicesFaq} />
    </div>
  </section>

  <!-- F. Ubicación y contacto -->
  <section class="container section" aria-labelledby="ubicacion-title">
    <LocationBlock headingId="ubicacion-title" />
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: var(--space-7);
    scroll-margin-top: var(--header-h);
  }

  @media (min-width: 64em) {
    .section {
      padding-top: var(--space-8);
    }
  }

  /* --- Hero (botones dentro del banner) ---------------------------------- */

  .banner-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .banner-actions .btn {
    flex: 0 1 auto;
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
  }

  @media (min-width: 48em) {
    .banner-actions {
      gap: var(--space-3);
    }

    .banner-actions .btn {
      flex: none;
      padding-inline: var(--space-5);
      font-size: var(--text-base);
    }
  }

  /* --- Servicios -------------------------------------------------------- */

  .services {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  @media (min-width: 48em) {
    .services {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .service :global(.media-placeholder) {
    border-radius: 0;
  }

  .service :global(.service__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* La etiqueta va a la derecha para no chocar con el icono del servicio. */
  .service :global(.media-placeholder__tag) {
    right: var(--space-2);
    left: auto;
  }

  .service__body > * {
    max-width: 100%;
  }

  .service__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-5);
  }

  /* Cada servicio tiene su propio color de acento para diferenciarlos de un vistazo. */
  .service__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-top: calc(var(--space-5) * -1 - 1.5rem);
    border: 3px solid var(--color-bg);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-sizing: content-box;
    position: relative;
  }

  .service__icon--alt {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .service h3 {
    font-size: var(--text-xl);
  }

  .service__examples {
    width: 100%;
  }

  .service__examples-title {
    font-weight: var(--font-semibold);
  }

  .service__examples ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-left: 1.25rem;
  }

  .service__examples li::marker {
    color: var(--color-primary);
  }

  .service__note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .service__notice {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-primary-tint);
    font-size: var(--text-sm);
  }

  .service__notice :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
    color: var(--color-primary);
  }

  .service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
    margin-top: auto;
  }

  @media (max-width: 29.99em) {
    .service__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* --- Agendar hora ------------------------------------------------------ */

  /* Banda azul a ancho completo: es la acción más importante de la página. */
  .booking-band {
    margin-top: var(--space-7);
    margin-bottom: 0;
    padding-block: var(--space-7);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .booking {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .booking__intro h2 {
    color: var(--color-on-primary);
  }

  .booking__lead {
    max-width: 50ch;
    margin-top: var(--space-3);
    color: var(--color-on-primary);
    font-size: var(--text-lg);
  }

  .booking__notes {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .booking__notes li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.1);
  }

  /* Aviso de edad: tarjeta blanca para que destaque sobre el azul. */
  .booking__notes li.booking__note--strong {
    border-color: var(--color-bg);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .booking__notes :global(.icon) {
    margin-top: 0.125rem;
    color: var(--color-accent);
  }

  .booking__notes li.booking__note--strong :global(.icon) {
    color: var(--color-primary);
  }

  .booking__slot {
    display: block;
  }

  .booking__form {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 48em) {
    .booking__form {
      padding: var(--space-6);
    }
  }

  @media (min-width: 64em) {
    .booking {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  /* --- Cómo solicitar atención ------------------------------------------ */

  .how {
    padding-block: var(--space-7);
    background: var(--color-primary-tint);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .steps li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .steps__number {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: var(--font-bold);
  }

  .steps h3 {
    font-size: var(--text-lg);
  }

  .steps p {
    margin-top: var(--space-1);
  }

  .how__contact {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .how__contact > p {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .how__buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  @media (min-width: 48em) {
    .how__contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .how__buttons {
      flex: 1 1 32rem;
      max-width: 40rem;
      margin-top: 0;
    }
  }

  .faq-wrap {
    margin-top: var(--space-5);
  }
</style>
