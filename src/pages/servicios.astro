---
/**
 * SERVICIOS — página orientada a la reserva de atención visual.
 * Jerarquía: 1) atención visual (protagonista) → 2) agenda online en tres pasos →
 * 3) reparación y ajuste (secundario, por WhatsApp) → preguntas frecuentes → ubicación.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import { Image } from 'astro:assets';
import heroServicios from '../assets/hero-atencion-visual.jpg';
import fotoAtencionVisual from '../assets/servicio-atencion-visual.jpg';
import fotoReparacion from '../assets/servicio-reparacion.jpg';
import LocationBlock from '../components/ui/LocationBlock.astro';
import Faq from '../components/ui/Faq.astro';
import ServicePrice from '../components/ui/ServicePrice.astro';
import AppointmentForm from '../components/forms/AppointmentForm.astro';
import { site } from '../config/site';
import { services, servicesFaq } from '../data/services';
import { whatsappUrl } from '../lib/whatsapp';

const visualCare = services.find((service) => service.slug === 'atencion-visual')!;
const repair = services.find((service) => service.slug === 'reparacion-y-ajuste')!;
const newTab = ' (se abre en una pestaña nueva)';

/* Fotos PROVISIONALES de banco: reemplazar por fotografías reales de Óptica Erredos. */
const photos: Record<string, { src: ImageMetadata; alt: string; position: string }> = {
  'atencion-visual': { src: fotoAtencionVisual, alt: 'Persona probándose lentes de prueba durante una evaluación visual', position: 'center 30%' },
  'reparacion-y-ajuste': { src: fotoReparacion, alt: 'Manos ajustando unos anteojos con un destornillador sobre un mesón con herramientas', position: 'center 55%' },
};
---

<BaseLayout
  title="Servicios: atención visual y reparación de anteojos"
  description="Agenda tu hora de atención visual con tecnóloga en Óptica Erredos, Calle Talca 118, Puerto Montt. También reparación y ajuste de anteojos por WhatsApp."
>
  <!-- A. Encabezado -->
  <PageBanner
    title="Tu salud visual merece atención."
    text="Conoce nuestra atención visual y agenda tu hora de manera fácil y online."
    image={heroServicios}
    imagePosition="62% 18%"
  >
    {visualCare.pricing && <p class="banner-fine">{visualCare.pricing.fine}</p>}
    <div class="banner-actions">
      <a class="btn btn--primary" href="#agendar-hora">
        <Icon name="event_available" />
        <span>Agenda tu hora</span>
      </a>
    </div>
  </PageBanner>

  <!-- B. Atención visual (protagonista) -->
  <section class="container section" id="solicitar-atencion" aria-labelledby="atencion-title">
    <article class="care" id="atencion-visual">
      <div class="care__media">
        <Image
          class="care__photo"
          src={photos['atencion-visual'].src}
          alt={photos['atencion-visual'].alt}
          widths={[480, 720, 1000]}
          sizes="(min-width: 64em) 560px, 100vw"
          style={`object-position: ${photos['atencion-visual'].position}`}
        />
      </div>
      <div class="care__body">
        <h2 id="atencion-title">{visualCare.name}</h2>
        <p class="care__lead">{visualCare.description}</p>
        {visualCare.pricing && <ServicePrice {...visualCare.pricing} />}
        <p class="care__notice">
          <Icon name="info" />
          <span>{visualCare.notice}</span>
        </p>
        <a class="btn btn--primary care__cta" href="#agendar-hora">
          <Icon name="event_available" />
          <span>Agenda tu hora</span>
        </a>
      </div>
    </article>
  </section>

  <!-- C. Agenda online -->
  <section class="booking-band" id="agendar-hora" aria-labelledby="booking-title">
    <div class="container booking">
      <div class="booking__intro">
        <p class="eyebrow">Agenda online</p>
        <h2 id="booking-title">Agenda tu atención visual</h2>
        <p class="booking__lead">Elige el día y horario que más te acomode y solicita tu atención online.</p>
        <ul role="list" class="booking__notes">
          {visualCare.pricing && (
            <li class="booking__note--price">
              <Icon name="sell" />
              <span>
                <strong>Valor de la atención: {visualCare.pricing.amount}</strong>
                {visualCare.pricing.benefit}
              </span>
            </li>
          )}
          <li class="booking__note--strong">
            <Icon name="info" />
            <span><strong>{site.appointments.ageNotice}</strong></span>
          </li>
        </ul>
        <ol role="list" class="booking__steps" aria-label="Cómo pedir tu hora">
          <li><span class="booking__step-n" aria-hidden="true">1</span><span>Elige la fecha y la hora.</span></li>
          <li><span class="booking__step-n" aria-hidden="true">2</span><span>Completa tus datos.</span></li>
          <li><span class="booking__step-n" aria-hidden="true">3</span><span>¡Listo! Tu hora queda agendada.</span></li>
        </ol>
      </div>
      <div class="booking__form">
        <AppointmentForm />
      </div>
    </div>
  </section>

  <!-- D. Reparación y ajuste (secundario) -->
  <section class="container section" aria-labelledby="repair-title">
    <article class="repair" id="reparacion-y-ajuste">
      <div class="repair__media">
        <Image
          class="repair__photo"
          src={photos['reparacion-y-ajuste'].src}
          alt={photos['reparacion-y-ajuste'].alt}
          widths={[360, 560, 800]}
          sizes="(min-width: 48em) 340px, 100vw"
          style={`object-position: ${photos['reparacion-y-ajuste'].position}`}
        />
      </div>
      <div class="repair__body">
        <h2 id="repair-title">{repair.name}</h2>
        <p>{repair.description}</p>
        <p class="repair__note">{repair.examples?.note}</p>
        <a class="btn btn--outline" href={whatsappUrl(repair.whatsappMessage)} target="_blank" rel="noopener">
          <Icon name="chat" />
          <span>{repair.cta}<span class="visually-hidden"> por WhatsApp{newTab}</span></span>
        </a>
      </div>
    </article>
  </section>

  <!-- E. Preguntas frecuentes -->
  <section class="container section" aria-labelledby="faq-title">
    <div class="faq-layout">
      <div class="faq-intro">
        <h2 id="faq-title">Preguntas frecuentes</h2>
        <p>¿Tienes otra duda? Escríbenos y te orientamos.</p>
        <a class="btn btn--outline" href={whatsappUrl()} target="_blank" rel="noopener">
          <Icon name="chat" />
          <span>Escribir por WhatsApp<span class="visually-hidden">{newTab}</span></span>
        </a>
      </div>
      <div class="faq-wrap">
        <Faq groups={servicesFaq} />
      </div>
    </div>
  </section>

  <!-- F. Ubicación y contacto -->
  <section class="container section" aria-labelledby="ubicacion-title">
    <LocationBlock headingId="ubicacion-title" />
  </section>
</BaseLayout>

<style>
  /* Desplazamiento suave hacia la agenda (se anula con "reducir movimiento"). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .section {
    padding-top: var(--section-gap);
    scroll-margin-top: var(--header-h);
  }


  .eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Etiqueta de foto provisional: se quita al poner fotografías reales. */
  /* --- Encabezado -------------------------------------------------------- */

  .banner-fine {
    max-width: 38ch;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .banner-actions {
    margin-top: var(--space-5);
  }

  .banner-fine + .banner-actions {
    margin-top: var(--space-3);
  }

  /* --- Atención visual (protagonista) ------------------------------------ */

  .care {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-primary-tint);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .care__media {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .care :global(.care__photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .care__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
  }

  .care__lead {
    max-width: 52ch;
    font-size: var(--text-lg);
  }

  .care__notice {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .care__notice :global(.icon) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
  }

  @media (max-width: 29.99em) {
    .care__cta {
      width: 100%;
    }
  }

  @media (min-width: 64em) {
    .care {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .care__media {
      aspect-ratio: auto;
      min-height: 26rem;
    }

    .care__body {
      justify-content: center;
      padding: var(--space-7);
    }
  }

  /* --- Agenda ------------------------------------------------------------ */

  /* Banda azul a ancho completo: es la acción más importante de la página. */
  .booking-band {
    margin-top: var(--section-gap);
    padding-block: calc(var(--section-gap) - 0.5rem);
    background: var(--color-primary);
    color: var(--color-on-primary);
    scroll-margin-top: var(--header-h);
  }

  .booking-band .eyebrow {
    color: var(--color-accent);
  }

  .booking {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .booking__intro h2 {
    color: var(--color-on-primary);
  }

  .booking__lead {
    max-width: 50ch;
    margin-top: var(--space-3);
    color: var(--color-on-primary);
    font-size: var(--text-lg);
  }

  .booking__notes {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .booking__notes li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.1);
  }

  /* Aviso de edad: tarjeta blanca para que destaque sobre el azul. */
  .booking__notes li.booking__note--strong {
    border-color: var(--color-bg);
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* Valor de la atención: tarjeta coral, dato importante junto a la agenda. */
  .booking__notes li.booking__note--price {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .booking__notes li.booking__note--price :global(.icon) {
    color: var(--color-primary);
  }

  .booking__notes :global(.icon) {
    flex: none;
    margin-top: 0.125rem;
    color: var(--color-accent);
  }

  .booking__notes li.booking__note--strong :global(.icon) {
    color: var(--color-primary);
  }

  .booking__notes strong {
    display: block;
  }

  .booking__steps {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    counter-reset: none;
  }

  .booking__steps li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-on-primary);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .booking__step-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
  }

  .booking__form {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 48em) {
    .booking__form {
      padding: var(--space-6);
    }
  }

  @media (min-width: 64em) {
    .booking-band {
      padding-block: var(--space-8);
    }

    .booking {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  /* --- Reparación y ajuste (secundario) ---------------------------------- */

  .repair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .repair__media {
    position: relative;
    aspect-ratio: 16 / 7;
  }

  .repair :global(.repair__photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .repair__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-5);
  }

  .repair__body h2 {
    font-size: var(--text-xl);
  }

  .repair__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 29.99em) {
    .repair__body .btn {
      width: 100%;
    }
  }

  @media (min-width: 48em) {
    .repair {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .repair__media {
      aspect-ratio: auto;
      min-height: 13rem;
    }
  }

  .faq-intro {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .faq-wrap {
    margin-top: var(--space-5);
  }

  /* Escritorio: título y ayuda a la izquierda, preguntas a la derecha (sin vacío a un lado). */
  @media (min-width: 64em) {
    .faq-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: var(--space-7);
      align-items: start;
    }

    .faq-intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
    }

    .faq-wrap {
      margin-top: 0;
    }

    .faq-wrap :global(.faq) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
