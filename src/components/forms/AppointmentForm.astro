---
/**
 * Agenda de hora para atención visual, en tres pasos:
 *   1. Seleccionar fecha y hora (vista semanal, bloques de 30 minutos).
 *   2. Completar datos de contacto (nombre, correo, celular y rango de edad del paciente).
 *   3. Revisar la solicitud y enviarla.
 * Después del envío se muestra "Solicitud recibida": la hora queda PENDIENTE de confirmación.
 *
 * Las horas se calculan desde `site.appointments` (bloques y duración).
 * LIMITACIÓN: no hay un sistema de agenda conectado, así que el sitio no sabe qué horas
 * ya están tomadas. En modo maqueta (`site.prototypeMode`) el flujo termina en la pantalla
 * final, pero no se envía ni se guarda nada.
 * La validación, el envío y el modo demostración viven en FormBehavior.astro. El paso 2 envía el
 * formulario para validar y FormBehavior avisa con `form:valid`; el paso 3 hace el envío real.
 */
import Icon from '../ui/Icon.astro';
import FormBehavior from './FormBehavior.astro';
import { site } from '../../config/site';
import { whatsappUrl, whatsappMessages } from '../../lib/whatsapp';

const isDemo = !site.formEndpoint && !site.prototypeMode;
const { appointments } = site;
const progress = ['Fecha y hora', 'Tus datos', 'Revisión'];
---

<div class="booking-ui" data-booking data-config={JSON.stringify(appointments)}>
  <noscript>
    <p class="booking-ui__empty">
      Para elegir una hora aquí necesitas tener JavaScript activado. También puedes pedir tu hora por
      <a href={whatsappUrl(whatsappMessages.visualCare)}>WhatsApp</a>.
    </p>
  </noscript>

  <!-- Indicador de progreso: el paso actual lleva aria-current; los completados llevan un check. -->
  <ol class="progress" data-progress aria-label="Progreso de tu solicitud" hidden>
    {
      progress.map((label, index) => (
        <li class="progress__item" data-progress-step={index + 1}>
          <span class="progress__dot" aria-hidden="true">
            <span class="progress__num">{index + 1}</span>
            <Icon name="check" />
          </span>
          <span class="progress__label">
            <span class="visually-hidden">Paso {index + 1} de 3: </span>
            {label}
            <span class="visually-hidden" data-progress-state />
          </span>
        </li>
      ))
    }
  </ol>

  <!-- PASO 1: fecha y hora -->
  <section class="booking-ui__step" data-step="1" aria-labelledby="booking-step-1" hidden>
    <h3 id="booking-step-1" tabindex="-1">Selecciona fecha y hora</h3>

    <div class="week">
      <button type="button" class="icon-btn week__nav" data-week-prev aria-label="Semana anterior">
        <Icon name="chevron_left" />
      </button>
      <div class="week__label" aria-live="polite">
        <p class="week__month" data-month></p>
        <p class="week__range" data-range></p>
      </div>
      <button type="button" class="icon-btn week__nav" data-week-next aria-label="Semana siguiente">
        <Icon name="chevron_right" />
      </button>
    </div>

    <div class="days" role="group" aria-label="Días de la semana" data-days></div>

    <ul class="legend" role="list" aria-label="Cómo leer el calendario">
      <li><span class="legend__swatch legend__swatch--open" aria-hidden="true"></span>Con horas</li>
      <li><span class="legend__swatch legend__swatch--picked" aria-hidden="true"></span>Elegido</li>
      <li><span class="legend__swatch legend__swatch--off" aria-hidden="true">—</span>Sin horas</li>
    </ul>

    <div class="slots" data-slots aria-live="polite"></div>

    <div class="booking-ui__footer">
      <p class="booking-ui__choice" data-choice>Todavía no eliges una hora.</p>
      <button type="button" class="btn btn--primary" data-continue aria-disabled="true">Continuar</button>
    </div>
  </section>

  <form
    class="form"
    id="form-hora"
    novalidate
    data-form
    data-endpoint={site.formEndpoint}
    data-prototype={String(site.prototypeMode)}
    data-wa-base={whatsappUrl('')}
    data-wa-intro="Hola, quisiera solicitar una hora de atención visual en Óptica Erredos."
    data-demo-title="Tus datos están correctos, pero la solicitud no se envió."
    data-demo-text="Este formulario está en modo demostración y aún no está conectado con Óptica Erredos, así que no hay ninguna solicitud registrada. Para pedir esta hora ahora, envía los mismos datos por WhatsApp."
    data-success-title="Solicitud recibida."
    data-success-text="Tu hora queda pendiente de confirmación: el equipo de Óptica Erredos te contactará."
  >
    {
      isDemo && (
        <p class="form__demo" role="note">
          <Icon name="info" />
          <span>
            <strong>Agenda en modo demostración.</strong> Todavía no está conectada: puedes probarla, pero tu
            solicitud no se enviará a Óptica Erredos.
          </span>
        </p>
      )
    }

    <input type="hidden" name="servicio" value="Atención visual" />
    <input type="hidden" name="dia" data-field-day data-wa-label="Día" />
    <input type="hidden" name="hora" data-field-time data-wa-label="Hora" />

    <!-- PASO 2: datos -->
    <section class="booking-ui__step" data-step="2" aria-labelledby="booking-step-2" hidden>
      <h3 id="booking-step-2" tabindex="-1">Completa tus datos</h3>

      <div class="booking-ui__summary">
        <Icon name="event_available" />
        <p>
          <span>Fecha y hora elegidas</span>
          <strong data-summary></strong>
        </p>
        <button type="button" class="btn btn--outline" data-change>Cambiar</button>
      </div>

      <p class="form__legend">Todos los campos son obligatorios.</p>

      <div class="form__grid">
        <div class="field form__wide">
          <label class="field__label" for="hora-nombre">Nombre y apellido</label>
          <input
            class="field__control"
            id="hora-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            placeholder="Ej.: María González"
            required
            data-wa-label="Nombre"
            data-error="Escribe tu nombre y apellido."
          />
        </div>

        <div class="field">
          <label class="field__label" for="hora-correo">Correo electrónico</label>
          <input
            class="field__control"
            id="hora-correo"
            name="correo"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="nombre@correo.cl"
            required
            data-wa-label="Correo"
            data-error="Escribe un correo válido, por ejemplo nombre@correo.cl."
          />
        </div>

        <div class="field">
          <label class="field__label" for="hora-celular">Teléfono de contacto</label>
          <input
            class="field__control"
            id="hora-celular"
            name="celular"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            placeholder="Ej.: 9 1234 5678"
            required
            data-wa-label="Celular"
            data-error="Escribe un teléfono con al menos 8 dígitos para poder confirmar tu hora."
          />
        </div>

        <div class="field form__wide">
          <label class="field__label" for="hora-edad">Rango de edad del paciente</label>
          <select
            class="field__control"
            id="hora-edad"
            name="edad"
            required
            aria-describedby="hora-edad-nota"
            data-wa-label="Edad del paciente"
            data-error="Elige el rango de edad de la persona que se atenderá."
          >
            <option value="">Elige una opción</option>
            {appointments.ageRanges.map((range) => <option value={range}>{range}</option>)}
          </select>
        </div>

        <p class="booking-ui__age form__wide" id="hora-edad-nota">
          <Icon name="info" />
          <span>{appointments.ageNotice}</span>
        </p>
      </div>

      <p class="form__privacy">
        Usaremos estos datos solo para coordinar tu atención. Revisa la{' '}
        <a href="/politica-de-privacidad">política de privacidad</a>.
      </p>

      <div class="booking-ui__footer booking-ui__footer--end">
        <button type="button" class="btn btn--outline" data-back-1>
          <Icon name="arrow_back" />
          <span>Volver</span>
        </button>
        <button type="submit" class="btn btn--primary">Continuar</button>
      </div>
    </section>

    <!-- PASO 3: revisión -->
    <section class="booking-ui__step" data-step="3" aria-labelledby="booking-step-3" hidden>
      <h3 id="booking-step-3" tabindex="-1">Revisa tu solicitud</h3>

      <dl class="booking-ui__details">
        <div>
          <dt>Fecha y hora</dt>
          <dd data-review-when></dd>
        </div>
        <div>
          <dt>Servicio</dt>
          <dd>Atención visual</dd>
        </div>
        <div>
          <dt>Nombre</dt>
          <dd data-review-name></dd>
        </div>
        <div>
          <dt>Correo electrónico</dt>
          <dd data-review-email></dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd data-review-phone></dd>
        </div>
        <div>
          <dt>Edad del paciente</dt>
          <dd data-review-age></dd>
        </div>
      </dl>

      <p class="booking-ui__notice" role="note">
        <Icon name="schedule" />
        <span>
          <strong>Tu hora quedará pendiente de confirmación.</strong>
          Al enviar, el equipo de Óptica Erredos revisará tu solicitud y se comunicará contigo.
        </span>
      </p>

      <div class="booking-ui__footer booking-ui__footer--end">
        <button type="button" class="btn btn--outline" data-back-2>
          <Icon name="arrow_back" />
          <span>Corregir datos</span>
        </button>
        <button type="submit" class="btn btn--primary form__submit" data-submit>
          <span data-submit-label>Enviar solicitud</span>
        </button>
      </div>
    </section>

    <div class="form__status" data-status role="status" aria-live="polite" tabindex="-1" hidden></div>
  </form>

  <!-- PASO FINAL: solicitud recibida (pendiente de confirmación) -->
  <section class="booking-ui__step booking-ui__done" data-step="4" aria-labelledby="booking-step-4" hidden>
    <span class="booking-ui__check"><Icon name="check_circle" /></span>
    <h3 id="booking-step-4" tabindex="-1">Solicitud recibida</h3>
    <p class="booking-ui__notice" role="note">
      <Icon name="schedule" />
      <span>
        <strong>Tu hora aún no está confirmada.</strong>
        El equipo de Óptica Erredos se comunicará contigo para confirmarla.
      </span>
    </p>
    <dl class="booking-ui__details">
      <div>
        <dt>Fecha y hora solicitadas</dt>
        <dd data-done-when></dd>
      </div>
      <div>
        <dt>Servicio</dt>
        <dd>Atención visual</dd>
      </div>
      <div>
        <dt>A nombre de</dt>
        <dd data-done-name></dd>
      </div>
      <div>
        <dt>Contacto</dt>
        <dd data-done-contact></dd>
      </div>
    </dl>
    <p class="booking-ui__hint">Si necesitas cambiar o anular tu solicitud, escríbenos por WhatsApp.</p>
    <div class="booking-ui__done-actions">
      <button type="button" class="btn btn--primary" data-restart>Solicitar otra hora</button>
      <a class="btn btn--outline" href={whatsappUrl(whatsappMessages.visualCare)} target="_blank" rel="noopener">
        <Icon name="chat" />
        <span>Escribir por WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span></span>
      </a>
    </div>
  </section>
</div>

<FormBehavior />

<script>
  interface Config {
    slotMinutes: number;
    weeksAhead: number;
    weekdays: [string, string][];
    saturday: [string, string][];
  }

  const startOfDay = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const addDays = (date: Date, days: number) => new Date(date.getFullYear(), date.getMonth(), date.getDate() + days);
  const iso = (date: Date) =>
    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
  const format = (date: Date, options: Intl.DateTimeFormatOptions) => date.toLocaleDateString('es-CL', options);
  const minutes = (time: string) => Number(time.slice(0, 2)) * 60 + Number(time.slice(3));
  const clock = (total: number) => `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;

  function initBooking() {
    const root = document.querySelector<HTMLElement>('[data-booking]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const config = JSON.parse(root.dataset.config ?? '{}') as Config;
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const step1 = $('[data-step="1"]');
    const step2 = $('[data-step="2"]');
    const step3 = $('[data-step="3"]');
    const step4 = $('[data-step="4"]');
    const form = $<HTMLFormElement>('[data-form]');
    const status = $('[data-status]');
    const progress = $('[data-progress]');
    let currentStep = 1;
    const daysBox = $('[data-days]');
    const slotsBox = $('[data-slots]');
    const monthLabel = $('[data-month]');
    const rangeLabel = $('[data-range]');
    const prev = $<HTMLButtonElement>('[data-week-prev]');
    const next = $<HTMLButtonElement>('[data-week-next]');
    const choice = $('[data-choice]');
    const proceed = $<HTMLButtonElement>('[data-continue]');
    const summary = $('[data-summary]');
    const dayField = $<HTMLInputElement>('[data-field-day]');
    const timeField = $<HTMLInputElement>('[data-field-time]');

    const today = startOfDay(new Date());
    // Se puede pedir hora desde mañana y hasta `weeksAhead` semanas.
    const firstDay = addDays(today, 1);
    const firstMonday = addDays(today, -((today.getDay() + 6) % 7));
    const lastDay = addDays(firstMonday, config.weeksAhead * 7 - 1);

    let weekOffset = 0;
    let selectedDay: Date | null = null;
    let selectedTime: string | null = null;

    // Horas agendadas durante esta visita: dejan de ofrecerse (solo en este navegador).
    const TAKEN_KEY = 'erredos:horas-agendadas';
    const taken = new Set<string>();
    try {
      (JSON.parse(sessionStorage.getItem(TAKEN_KEY) ?? '[]') as string[]).forEach((key) => taken.add(key));
    } catch {
      /* sin almacenamiento disponible */
    }

    /** Bloques de atención del día (vacío = no se atiende). */
    function blocksFor(date: Date) {
      if (date < firstDay || date > lastDay) return [];
      const weekday = date.getDay();
      if (weekday === 0) return [];
      return weekday === 6 ? config.saturday : config.weekdays;
    }

    function slotsFor(date: Date) {
      return blocksFor(date).map(([from, to]) => {
        const times: string[] = [];
        for (let t = minutes(from); t + config.slotMinutes <= minutes(to); t += config.slotMinutes) times.push(clock(t));
        return times;
      });
    }

    const weekStart = () => addDays(firstMonday, weekOffset * 7);
    const longDay = (date: Date) => format(date, { weekday: 'long', day: 'numeric', month: 'long' });

    function setDisabled(button: HTMLButtonElement, disabled: boolean) {
      button.setAttribute('aria-disabled', String(disabled));
    }

    function renderWeek() {
      const start = weekStart();
      const end = addDays(start, 6);
      const sameMonth = start.getMonth() === end.getMonth();
      // Mes y año siempre visibles; si la semana cruza de mes, se muestran ambos.
      monthLabel.textContent = sameMonth
        ? capitalize(format(start, { month: 'long', year: 'numeric' }))
        : `${capitalize(format(start, { month: 'long' }))} – ${format(end, { month: 'long', year: 'numeric' })}`;
      rangeLabel.textContent = `Semana del ${start.getDate()}${sameMonth ? '' : ` de ${format(start, { month: 'long' })}`} al ${end.getDate()} de ${format(end, { month: 'long' })}`;
      setDisabled(prev, weekOffset === 0);
      setDisabled(next, weekOffset >= config.weeksAhead - 1);

      daysBox.replaceChildren(
        ...Array.from({ length: 7 }, (_, index) => {
          const date = addDays(start, index);
          const available = slotsFor(date).length > 0;
          const selected = selectedDay !== null && iso(selectedDay) === iso(date);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'days__btn';
          button.dataset.date = iso(date);
          button.disabled = !available;
          button.setAttribute('aria-pressed', String(selected));
          button.setAttribute(
            'aria-label',
            `${longDay(date)}${available ? '' : ', sin horas disponibles'}${iso(date) === iso(today) ? ' (hoy)' : ''}`,
          );
          const weekday = capitalize(format(date, { weekday: 'short' }).replace('.', ''));
          button.innerHTML = `<span class="days__weekday">${weekday}</span><span class="days__number">${date.getDate()}</span><span class="days__state">${available ? '' : '—'}</span>`;
          return button;
        }),
      );
    }

    function renderSlots() {
      if (!selectedDay) {
        slotsBox.innerHTML = '<p class="booking-ui__empty">Elige un día para ver sus horas.</p>';
        return;
      }
      const [morning = [], afternoon = []] = slotsFor(selectedDay);
      const group = (title: string, times: string[]) =>
        times.length
          ? `<div class="slots__group" role="group" aria-label="${title}"><p class="slots__title">${title}</p><div class="slots__grid">${times
              .map(
                (time) =>
                  taken.has(`${iso(selectedDay!)} ${time}`)
                    ? `<button type="button" class="slots__btn" disabled aria-label="${time}, hora no disponible">${time}</button>`
                    : `<button type="button" class="slots__btn" data-time="${time}" aria-pressed="${time === selectedTime}">${time}</button>`,
              )
              .join('')}</div></div>`
          : '';
      slotsBox.innerHTML = `<p class="slots__heading">Horas para el <strong>${longDay(selectedDay)}</strong></p>${group('Mañana', morning)}${group('Tarde', afternoon)}`;
    }

    function renderChoice() {
      const ready = Boolean(selectedDay && selectedTime);
      choice.innerHTML = ready
        ? `Elegiste: <strong>${longDay(selectedDay!)}, ${selectedTime} hrs</strong>`
        : selectedDay
          ? 'Ahora elige una hora.'
          : 'Todavía no eliges una hora.';
      setDisabled(proceed, !ready);
    }

    function selectDay(date: Date) {
      selectedDay = date;
      selectedTime = null;
      renderWeek();
      renderSlots();
      renderChoice();
    }

    const progressState = ['Paso completado', 'Paso actual', 'Paso pendiente'];
    function showStep(step: 1 | 2 | 3 | 4) {
      currentStep = step;
      const steps = [step1, step2, step3, step4];
      steps.forEach((section, index) => (section.hidden = index !== step - 1));
      status.hidden = true;
      // Indicador de progreso: oculto en la pantalla final.
      progress.hidden = step === 4;
      progress.querySelectorAll<HTMLElement>('[data-progress-step]').forEach((item) => {
        const number = Number(item.dataset.progressStep);
        const state = number < step ? 'done' : number === step ? 'current' : 'todo';
        item.dataset.state = state;
        if (state === 'current') item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
        item.querySelector('[data-progress-state]')!.textContent = ` (${progressState[state === 'done' ? 0 : state === 'current' ? 1 : 2].toLowerCase()})`;
      });
      steps[step - 1].querySelector<HTMLElement>('h3')!.focus();
    }

    /* --- Eventos ----------------------------------------------------------- */

    const move = (delta: number) => {
      const target = weekOffset + delta;
      if (target < 0 || target > config.weeksAhead - 1) return;
      weekOffset = target;
      renderWeek();
    };
    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    daysBox.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-date]');
      if (!button || button.disabled) return;
      const [year, month, day] = button.dataset.date!.split('-').map(Number);
      selectDay(new Date(year, month - 1, day));
      // El foco sigue en el día recién elegido (los botones se vuelven a dibujar).
      daysBox.querySelector<HTMLButtonElement>(`[data-date="${button.dataset.date}"]`)?.focus();
    });

    slotsBox.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-time]');
      if (!button) return;
      selectedTime = button.dataset.time!;
      slotsBox.querySelectorAll('[data-time]').forEach((slot) => {
        slot.setAttribute('aria-pressed', String(slot === button));
      });
      renderChoice();
    });

    proceed.addEventListener('click', () => {
      if (!selectedDay || !selectedTime) {
        choice.textContent = 'Primero elige un día y una hora.';
        return;
      }
      const text = `${capitalize(longDay(selectedDay))} de ${selectedDay.getFullYear()}, ${selectedTime} hrs`;
      summary.textContent = text;
      dayField.value = `${longDay(selectedDay)} de ${selectedDay.getFullYear()}`;
      timeField.value = `${selectedTime} hrs`;
      showStep(2);
    });

    $('[data-change]').addEventListener('click', () => showStep(1));
    $('[data-back-1]').addEventListener('click', () => showStep(1));
    $('[data-back-2]').addEventListener('click', () => showStep(2));

    // Paso 2 → 3: los datos ya pasaron la validación; se muestra el resumen para revisar.
    form.addEventListener('form:valid', (event) => {
      if (currentStep !== 2) return;
      event.preventDefault();
      const data = (event as CustomEvent<Record<string, string>>).detail;
      $('[data-review-when]').textContent = summary.textContent;
      $('[data-review-name]').textContent = data.nombre;
      $('[data-review-email]').textContent = data.correo;
      $('[data-review-phone]').textContent = data.celular;
      $('[data-review-age]').textContent = data.edad;
      showStep(3);
    });

    // Al terminar el envío se muestra "Solicitud recibida" (pendiente de confirmación).
    root.addEventListener('form:success', (event) => {
      event.preventDefault();
      const data = (event as CustomEvent<Record<string, string>>).detail;
      $('[data-done-when]').textContent = summary.textContent;
      $('[data-done-name]').textContent = data.nombre;
      $('[data-done-contact]').textContent = `${data.celular} · ${data.correo}`;
      if (selectedDay && selectedTime) {
        taken.add(`${iso(selectedDay)} ${selectedTime}`);
        try {
          sessionStorage.setItem(TAKEN_KEY, JSON.stringify([...taken]));
        } catch {
          /* sin almacenamiento disponible */
        }
      }
      showStep(4);
    });

    $('[data-restart]').addEventListener('click', () => {
      selectedTime = null;
      renderWeek();
      renderSlots();
      renderChoice();
      showStep(1);
    });

    function showStepInitial() {
      progress.hidden = false;
      step1.hidden = false;
      progress.querySelectorAll<HTMLElement>('[data-progress-step]').forEach((item) => {
        const number = Number(item.dataset.progressStep);
        item.dataset.state = number === 1 ? 'current' : 'todo';
        if (number === 1) item.setAttribute('aria-current', 'step');
        item.querySelector('[data-progress-state]')!.textContent = number === 1 ? ' (paso actual)' : ' (paso pendiente)';
      });
    }

    /* --- Estado inicial: primera semana con horas, con su primer día marcado --- */

    for (let offset = 0; offset < config.weeksAhead && !selectedDay; offset += 1) {
      for (let index = 0; index < 7; index += 1) {
        const date = addDays(firstMonday, offset * 7 + index);
        if (slotsFor(date).length) {
          weekOffset = offset;
          selectedDay = date;
          break;
        }
      }
    }
    showStepInitial();
    renderWeek();
    renderSlots();
    renderChoice();
  }

  initBooking();
