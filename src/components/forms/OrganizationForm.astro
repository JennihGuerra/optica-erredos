---
/**
 * Formulario de contacto para organizaciones (convenios y operativos).
 * La validación, el envío y el modo demostración viven en FormBehavior.astro.
 */
import Icon from '../ui/Icon.astro';
import FormBehavior from './FormBehavior.astro';
import { site } from '../../config/site';
import { whatsappUrl } from '../../lib/whatsapp';

const requestTypes = [
  { value: 'convenio', label: 'Convenio óptico' },
  { value: 'operativo', label: 'Operativo óptico' },
  { value: 'ambos', label: 'Ambos' },
  { value: 'informacion', label: 'Necesito más información' },
];
const isDemo = !site.formEndpoint && !site.prototypeMode;
---

<form
  class="form"
  id="form-organizaciones"
  novalidate
  data-form
  data-org-form
  data-endpoint={site.formEndpoint}
  data-prototype={String(site.prototypeMode)}
  data-wa-base={whatsappUrl('')}
  data-wa-intro="Hola, represento a una organización y quisiera información sobre convenios y operativos ópticos."
  data-demo-title="Tus datos están correctos, pero no se enviaron."
  data-demo-text="Este formulario está en modo demostración y aún no está conectado con Óptica Erredos. Si quieres contactarnos ahora, envía esta misma información por WhatsApp."
  data-success-title="Recibimos tu solicitud."
  data-success-text="El equipo de Óptica Erredos la revisará y se pondrá en contacto contigo."
>
  {
    isDemo && (
      <p class="form__demo" role="note">
        <Icon name="info" />
        <span>
          <strong>Formulario en modo demostración.</strong> Todavía no está conectado: puedes probarlo,
          pero tus datos no se enviarán a Óptica Erredos.
        </span>
      </p>
    )
  }

  <p class="form__legend">Los campos sin la palabra "opcional" son obligatorios.</p>

  <div class="form__grid">
    <div class="field">
      <label class="field__label" for="org-nombre">Nombre y apellido</label>
      <input
        class="field__control"
        id="org-nombre"
        placeholder="Ej.: María González"
        name="nombre"
        type="text"
        autocomplete="name"
        required
        data-wa-label="Nombre"
        data-error="Escribe tu nombre y apellido."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-organizacion">Empresa u organización</label>
      <input
        class="field__control"
        id="org-organizacion"
        placeholder="Ej.: Sindicato de Trabajadores"
        name="organizacion"
        type="text"
        autocomplete="organization"
        required
        data-wa-label="Organización"
        data-error="Escribe el nombre de tu empresa u organización."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-correo">Correo electrónico</label>
      <input
        class="field__control"
        id="org-correo"
        placeholder="Ej.: maria.gonzalez@empresa.cl"
        name="correo"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        data-wa-label="Correo"
        data-error="Escribe un correo válido, por ejemplo nombre@empresa.cl."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-correo2">Confirma tu correo electrónico</label>
      <input
        class="field__control"
        id="org-correo2"
        name="correo_confirmacion"
        type="email"
        autocomplete="off"
        inputmode="email"
        placeholder="Ej.: maria.gonzalez@empresa.cl"
        required
        data-rule="match"
        data-match="#org-correo"
        data-error="Los correos no coinciden. Escríbelo igual que el de arriba."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-telefono">Número de teléfono</label>
      <input
        class="field__control"
        id="org-telefono"
        placeholder="Ej.: 9 1234 5678"
        name="telefono"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
        data-wa-label="Teléfono"
        data-error="Escribe un teléfono de contacto con al menos 8 dígitos."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-cargo">
        Cargo o función <span class="field__optional">(opcional)</span>
      </label>
      <input
        class="field__control"
        id="org-cargo"
        placeholder="Ej.: Encargada de bienestar"
        name="cargo"
        type="text"
        autocomplete="organization-title"
        data-wa-label="Cargo"
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-participantes">
        Cantidad de participantes <span class="field__optional">(aprox.)</span>
      </label>
      <input
        class="field__control"
        id="org-participantes"
        placeholder="Ej.: 40"
        name="participantes"
        type="number"
        inputmode="numeric"
        min="1"
        data-wa-label="Participantes (aprox.)"
        data-error="Escribe un número mayor que cero o deja el campo vacío."
      />
    </div>

    <div class="field">
      <label class="field__label" for="org-tipo">Tipo de solicitud</label>
      <select
        class="field__control"
        id="org-tipo"
        name="tipo"
        required
        data-wa-label="Tipo de solicitud"
        data-error="Elige qué tipo de solicitud quieres hacer."
      >
        <option value="">Elige una opción</option>
        {requestTypes.map((type) => <option value={type.value}>{type.label}</option>)}
      </select>
    </div>

    <div class="field form__wide">
      <label class="field__label" for="org-mensaje">
        Mensaje o información adicional <span class="field__optional">(opcional)</span>
      </label>
      <textarea class="field__control" id="org-mensaje" name="mensaje" rows="4" placeholder="Ej.: Queremos coordinar un operativo óptico para nuestros trabajadores." data-wa-label="Mensaje"></textarea>
    </div>
  </div>

  <p class="form__privacy">
    Usaremos estos datos solo para responder tu solicitud. No pedimos información de los participantes.
    Revisa la <a href="/politica-de-privacidad">política de privacidad</a>.
  </p>

  <button type="submit" class="btn btn--primary form__submit" data-submit>
    <span data-submit-label>Enviar solicitud</span>
  </button>

  <!-- Resumen de errores y resultado del envío: se anuncian a lectores de pantalla. -->
  <div class="form__status" data-status role="status" aria-live="polite" tabindex="-1" hidden></div>
</form>

<!-- Confirmación en ventana emergente: se abre al enviar la solicitud con éxito. -->
<dialog class="success-modal" id="org-success" aria-labelledby="org-success-title" aria-describedby="org-success-text">
  <div class="success-modal__icon" aria-hidden="true"><Icon name="check_circle" /></div>
  <h2 class="success-modal__title" id="org-success-title" tabindex="-1">¡Tu solicitud ha sido recibida exitosamente!</h2>
  <p class="success-modal__text" id="org-success-text">
    El equipo de Óptica Erredos se pondrá en contacto contigo.
  </p>
  <a class="btn btn--primary success-modal__exit" href="/">Salir</a>
</dialog>

<FormBehavior />

<script>
  function initSuccessModal() {
    const form = document.querySelector<HTMLFormElement>('#form-organizaciones');
    const modal = document.querySelector<HTMLDialogElement>('#org-success');
    if (!form || !modal || form.dataset.modalReady) return;
    form.dataset.modalReady = 'true';
    form.addEventListener('form:success', (event) => {
      event.preventDefault(); // evita el mensaje en línea: la confirmación va en la ventana
      if (!modal.open) modal.showModal();
      modal.querySelector<HTMLElement>('.success-modal__title')?.focus();
    });
    // Un clic fuera de la ventana también la cierra y deja al usuario en el formulario.
    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
  }
  initSuccessModal();
  document.addEventListener('astro:page-load', initSuccessModal);
</script>

<style is:global>
  .success-modal {
    width: min(26rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    margin: auto;
    padding: var(--space-6) var(--space-5);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    text-align: center;
    overflow: auto;
  }
  .success-modal[open] {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .success-modal::backdrop {
    background: rgb(33 33 33 / 0.55);
  }
  .success-modal__icon {
    color: var(--color-primary);
  }
  .success-modal__icon .icon {
    width: 3.5rem;
    height: 3.5rem;
  }
  .success-modal__title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .success-modal__title:focus {
    outline: none;
  }
  .success-modal__text {
    margin: 0;
    color: var(--color-text-muted);
  }
  .success-modal__exit {
    margin-top: var(--space-3);
    min-width: min(10rem, 100%);
  }
</style>
