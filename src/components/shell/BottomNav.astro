---
/**
 * Navegación inferior fija, solo para móviles. Se oculta desde 768 px,
 * donde la reemplaza el menú horizontal del header.
 */
import Icon from '../ui/Icon.astro';
import { mainNav, isActive } from '../../config/navigation';
import type { IconName } from '../ui/icons';

const { pathname } = Astro.url;
---

<nav class="bottom-nav" aria-label="Navegación principal">
  <ul role="list">
    {
      mainNav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href, pathname) ? 'page' : undefined}>
            <span class="bottom-nav__icon">
              <Icon name={item.icon} class="bottom-nav__outline" />
              <Icon name={`${item.icon}-fill` as IconName} class="bottom-nav__fill" />
            </span>
            <span class="bottom-nav__label">{item.shortLabel}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-bottom-nav);
    /* Respeta el área segura inferior (barra de gestos de iOS/Android). */
    padding-bottom: var(--safe-bottom);
    padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    max-width: 40rem;
    height: var(--bottom-nav-h);
    margin-inline: auto;
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Alineados arriba: los iconos quedan a la misma altura aunque una etiqueta use dos líneas. */
    justify-content: flex-start;
    gap: 0.125rem;
    height: 100%;
    padding-top: clamp(5px, 0.375rem, 8px);
    color: var(--color-text-muted);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  a:focus-visible {
    outline-offset: -3px;
  }

  .bottom-nav__icon {
    display: grid;
    place-items: center;
    width: clamp(52px, 3.5rem, 64px);
    height: clamp(28px, 1.875rem, 34px);
    border-radius: var(--radius-pill);
    transition: background-color var(--duration-base) var(--easing);
  }

  .bottom-nav__icon :global(.icon) {
    width: clamp(22px, 1.5rem, 28px);
    height: clamp(22px, 1.5rem, 28px);
  }

  .bottom-nav__icon :global(.bottom-nav__fill) {
    display: none;
  }

  .bottom-nav__label {
    max-width: 100%;
    padding-inline: 2px;
    /* Crece con el control de texto, pero con tope según el ancho disponible:
       cinco etiquetas deben caber siempre en una fila, incluso a 320 px. */
    font-size: min(0.75rem, 3.4vw, 16px);
    font-weight: var(--font-medium);
    /* Hasta dos líneas ("Quiénes somos"), centradas. */
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
  }

  a:hover .bottom-nav__icon {
    background: var(--color-primary-tint);
  }

  /* Estado activo: no depende solo del color → icono relleno + píldora + peso. */
  a[aria-current='page'] {
    color: var(--color-primary);
  }

  a[aria-current='page'] .bottom-nav__icon {
    background: var(--color-accent);
  }

  a[aria-current='page'] :global(.bottom-nav__outline) {
    display: none;
  }

  a[aria-current='page'] :global(.bottom-nav__fill) {
    display: block;
  }

  a[aria-current='page'] .bottom-nav__label {
    font-weight: var(--font-semibold);
  }

  @media (min-width: 48em) {
    .bottom-nav {
      display: none;
    }
  }
</style>
