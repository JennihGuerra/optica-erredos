---
/**
 * Botón flotante de WhatsApp en el borde derecho, siempre visible. Abre una consulta general.
 * Usa el coral de la paleta (no el verde de WhatsApp) con texto oscuro por contraste.
 */
import Icon from '../ui/Icon.astro';
import { whatsappUrl } from '../../lib/whatsapp';
import { contextMessage } from '../../lib/whatsappContext';
---

<a
  class="float-wa"
  href={whatsappUrl(contextMessage(Astro.url.pathname))}
  target="_blank"
  rel="noopener"
  aria-label="Haz aquí tus consultas por WhatsApp (se abre en una pestaña nueva)"
>
  <span class="float-wa__icon"><Icon name="chat" /></span>
  <span class="float-wa__label">Haz aquí tus consultas</span>
</a>

<style>
  .float-wa {
    position: fixed;
    right: var(--space-3);
    /* Móvil: sobre la barra inferior. */
    bottom: calc(var(--bottom-nav-h) + var(--safe-bottom) + var(--space-3));
    z-index: var(--z-float);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3.25rem;
    max-width: calc(100vw - 2 * var(--space-3));
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    /* Anillo blanco + sombra marcada: se separa del fondo claro y del azul. */
    box-shadow:
      0 0 0 3px var(--color-bg),
      0 6px 20px rgb(33 33 33 / 0.28);
    font-size: min(var(--text-base), 17px);
    font-weight: var(--font-bold);
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--easing),
      transform var(--duration-fast) var(--easing);
  }

  .float-wa:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  /* Círculo azul con el icono: aporta el color de marca y lo hace reconocible. */
  .float-wa__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .float-wa__label {
    min-width: 0;
  }

  /* Halo suave que late unas pocas veces al cargar para llamar la atención (no es permanente). */
  .float-wa::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgb(244 203 182 / 0.9);
    pointer-events: none;
    animation: float-wa-pulse 2.4s ease-out 1.5s 3;
  }

  @keyframes float-wa-pulse {
    to {
      box-shadow: 0 0 0 16px rgb(244 203 182 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-wa::after {
      animation: none;
    }

    .float-wa:hover {
      transform: none;
    }
  }

  @media (min-width: 48em) {
    .float-wa {
      right: var(--space-5);
      bottom: var(--space-5);
      min-height: 3.5rem;
      font-size: min(var(--text-lg), 19px);
    }

    .float-wa__icon {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
