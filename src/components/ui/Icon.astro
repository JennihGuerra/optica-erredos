---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
// Decorativo por defecto: el texto o aria-label del control entrega el nombre accesible.
const svg = icons[name]
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(
    '<svg ',
    `<svg class="icon${className ? ' ' + className : ''}" aria-hidden="true" focusable="false" fill="currentColor" `,
  );
---

<Fragment set:html={svg} />
