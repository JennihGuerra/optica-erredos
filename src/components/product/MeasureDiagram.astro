---
/**
 * Esquema de una medida del marco (frente o varilla) con una flecha de cota.
 * Decorativo: la medida se comunica con el texto que lo acompaña.
 */
interface Props {
  kind: 'height' | 'width' | 'bridge' | 'temple';
}

const { kind } = Astro.props;
const markerId = `measure-arrow-${kind}`;
---

<svg viewBox="0 0 200 100" aria-hidden="true" focusable="false" class="measure">
  <defs>
    <marker id={markerId} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M1 1 L9 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </marker>
  </defs>

  {
    kind === 'temple' ? (
      <>
        <path class="frame" d="M20 30 H150 Q182 30 184 52 V64" />
        <rect class="frame" x="14" y="24" width="8" height="12" rx="2" />
        <line class="dim" x1="20" y1="84" x2="184" y2="84" marker-start={`url(#${markerId})`} marker-end={`url(#${markerId})`} />
      </>
    ) : (
      <>
        <rect class="frame" x="15" y="20" width="72" height="52" rx="20" />
        <rect class="frame" x="113" y="20" width="72" height="52" rx="20" />
        <path class="frame" d="M87 38 Q100 30 113 38" />
        {kind === 'height' && (
          <line class="dim" x1="51" y1="22" x2="51" y2="70" marker-start={`url(#${markerId})`} marker-end={`url(#${markerId})`} />
        )}
        {kind === 'width' && (
          <line class="dim" x1="17" y1="46" x2="85" y2="46" marker-start={`url(#${markerId})`} marker-end={`url(#${markerId})`} />
        )}
        {kind === 'bridge' && (
          <>
            <line class="guide" x1="87" y1="20" x2="87" y2="46" />
            <line class="guide" x1="113" y1="20" x2="113" y2="46" />
            <line class="dim" x1="87" y1="28" x2="113" y2="28" marker-start={`url(#${markerId})`} marker-end={`url(#${markerId})`} />
          </>
        )}
      </>
    )
  }
</svg>

<style>
  .measure {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
    color: var(--color-primary);
  }

  .frame {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dim {
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .guide {
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.6;
  }
</style>
