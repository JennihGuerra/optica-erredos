---
/**
 * App Shell: estructura común a todas las páginas.
 * Header + contenido + footer + navegación inferior (móvil) + control de texto.
 */
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/card-hover.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/shell/Header.astro';
import BottomNav from '../components/shell/BottomNav.astro';
import Footer from '../components/shell/Footer.astro';
import TextSizeControl from '../components/shell/TextSizeControl.astro';
import FloatingWhatsApp from '../components/shell/FloatingWhatsApp.astro';
import { site } from '../config/site';

interface Props {
  /** Título de la página, sin el nombre del sitio. */
  title: string;
  description?: string;
  noindex?: boolean;
  /** Imagen para la vista previa al compartir (p. ej. en WhatsApp). Ruta o URL. */
  image?: string;
}

const { title, description = site.description, noindex = false, image } = Astro.props;
const ogImage = image ? (/^https?:/.test(image) ? image : Astro.site ? new URL(image, Astro.site).href : null) : null;
const fullTitle = `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#05596a" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Aplica el tamaño de texto guardado antes del primer pintado (sin parpadeo)
         y lo conserva en cada cambio de página. -->
    <script is:inline>
      (function () {
        var KEY = 'erredos:text-scale';
        var LEVELS = [87.5, 100, 112.5, 125, 137.5, 150];
        var DEFAULT = 1;
        function read() {
          try {
            var i = parseInt(localStorage.getItem(KEY), 10);
            return LEVELS[i] ? i : DEFAULT;
          } catch (e) {
            return DEFAULT;
          }
        }
        function apply(doc, i) {
          var root = doc.documentElement;
          root.style.setProperty('--text-scale', String(LEVELS[i] / 100));
          root.dataset.textScale = String(Math.floor(LEVELS[i]));
        }
        window.erredosTextSize = {
          levels: LEVELS,
          defaultIndex: DEFAULT,
          get: read,
          set: function (i) {
            i = Math.max(0, Math.min(LEVELS.length - 1, i));
            try {
              localStorage.setItem(KEY, String(i));
            } catch (e) {}
            apply(document, i);
            return i;
          },
        };
        apply(document, read());
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument, read());
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BottomNav />
    <TextSizeControl />
    <FloatingWhatsApp />
  </body>
</html>
